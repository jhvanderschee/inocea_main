loadJsonForCMSLookup({{- $pages := slice -}}
{{- range .Site.Pages -}}
  {{- $path := `` -}}
  {{- with .File -}}{{ $path = .Filename }}{{ end -}}
  {{- $path = replace $path hugo.WorkingDir `` -}}
  {{- if $path -}}
    {{- $pages = $pages | append (dict "permalink" .Permalink "path" $path) -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}});